# Backend-only database credentials.
DATABASE_ENGINE=mongodb
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=news24x7
MYSQL_USER=root
MYSQL_PASSWORD=
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=news24x7
# Optional DNS override; Windows already defaults to these servers.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace-with-a-random-64-character-secret
# Google OAuth web client: both values are needed to enable Google login.
# Local authorized redirect URI: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use matching HTTPS addresses and COOKIE_SECURE=true in production.
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
COOKIE_SECURE=false
NODE_ENV=development
# Behind ONE trusted reverse proxy, set TRUST_PROXY=1 and block direct API access.
TRUST_PROXY=0
# Production: same public origin preserves the browser-bound OAuth cookie.
# Register this exact URI with Google, e.g. https://YOUR_DOMAIN/api/backend/auth/google/callback
# GOOGLE_REDIRECT_URL=https://YOUR_DOMAIN/api/backend/auth/google/callback
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
