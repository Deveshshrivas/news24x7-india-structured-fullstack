# Copy to the project-root .env on the host. These settings assume the
# frontend/backend are on the same VPS behind the supplied HTTPS proxy.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
# Optional Search Console verification; this is not a Google OAuth client ID.
GOOGLE_SITE_VERIFICATION=
# Leave ads disabled until your approved account and slot IDs are configured.
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_HOME_TOP_SLOT=
ADSENSE_HOME_BOTTOM_SLOT=
ADSENSE_ARTICLE_INLINE_SLOT=
ADSENSE_ARTICLE_BOTTOM_SLOT=
ADSENSE_PUBLIC_BOTTOM_SLOT=
ADSENSE_ARTICLE_LEFT_TOP_SLOT=
ADSENSE_ARTICLE_LEFT_BOTTOM_SLOT=
ADSENSE_ARTICLE_RIGHT_TOP_SLOT=
ADSENSE_ARTICLE_RIGHT_BOTTOM_SLOT=
ADSENSE_ARTICLE_FOOTER_SLOT=
ADSENSE_ARTICLE_LEFT_EXTRA_SLOT=
ADSENSE_ARTICLE_RIGHT_EXTRA_SLOT=
# Do not put MySQL passwords or Google client secrets in the frontend file.
