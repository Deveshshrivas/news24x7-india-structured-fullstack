# Add these variables in Hostinger before the GitHub build. Never commit real secrets.
# Hostinger supplies PORT automatically; do not set it to the private API port.
NODE_ENV=production
DEPLOY_TARGET=node
API_INTERNAL_PORT=8000
DATABASE_ENGINE=mysql
MYSQL_HOST=YOUR_HOSTINGER_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=YOUR_HOSTINGER_DATABASE
MYSQL_USER=YOUR_HOSTINGER_APP_USER
MYSQL_PASSWORD=YOUR_HOSTINGER_DATABASE_PASSWORD
JWT_SECRET=replace-with-a-unique-random-64-character-secret
COOKIE_SECURE=true
TRUST_PROXY=0
FRONTEND_URL=https://beige-jackal-918802.hostingersite.com
NEXT_PUBLIC_SITE_URL=https://beige-jackal-918802.hostingersite.com
ALLOWED_ORIGINS=https://beige-jackal-918802.hostingersite.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://beige-jackal-918802.hostingersite.com/api/backend/auth/google/callback
GOOGLE_SITE_VERIFICATION=
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_HOME_TOP_SLOT=
ADSENSE_HOME_BOTTOM_SLOT=
ADSENSE_ARTICLE_INLINE_SLOT=
ADSENSE_ARTICLE_BOTTOM_SLOT=
